{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeNote",
  "version": "0.1.0",
  "identifier": "com.matthew.codenote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeNote",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "capture",
        "title": "Quick Capture",
        "width": 640,
        "height": 420,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
